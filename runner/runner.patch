+/// A snapshot of the app with this pid that fetches only the attributes behind
+/// these snapshot key paths ("label", "frame"...), as a dictionaryRepresentation.
+/// Every attribute left out is one less round of work in the accessibility server,
+/// which is what makes it cheaper than XCUIElement.snapshot(). Nil on any failure.
+- (nullable NSDictionary<XCUIElementAttributeName, id> *)snapshotDictionaryForProcessIdentifier:(int)pid
+                                                                                       keyPaths:(NSArray<NSString *> *)keyPaths
+    NS_SWIFT_NAME(snapshotDictionary(forProcessIdentifier:keyPaths:));
+
 @end
 
