diff --git a/DeviceKitTests/Utilities/AXClientProxy.m b/DeviceKitTests/Utilities/AXClientProxy.m
index 864aff0..784ef8e 100644
--- a/DeviceKitTests/Utilities/AXClientProxy.m
+++ b/DeviceKitTests/Utilities/AXClientProxy.m
@@ -7,6 +7,7 @@
 #import "XCAXClient_iOS.h"
 
 #import <dlfcn.h>
+#import <objc/message.h>
 #import "XCAccessibilityElement.h"
 #import "XCUIDevice.h"
 
@@ -169,4 +170,57 @@ - (nullable NSString *)viewControllerClassNameForProcessIdentifier:(int)pid {
     return nil == className ? nil : DemangledClassName(className);
 }
 
+#pragma mark - Reduced snapshot
+
+- (nullable NSDictionary<XCUIElementAttributeName, id> *)snapshotDictionaryForProcessIdentifier:(int)pid
+                                                                                       keyPaths:(NSArray<NSString *> *)keyPaths {
+    id element = nil;
+    for (id<XCAccessibilityElement> candidate in [AXClient activeApplications]) {
+        if (candidate.processIdentifier == pid) {
+            element = candidate;
+            break;
+        }
+    }
+    if (nil == element) {
+        return nil;
+    }
+
+    // XCElementSnapshot maps snapshot key paths to the accessibility attributes
+    // behind them; the AX server does not take the key paths themselves
+    // (private API, as WebDriverAgent uses it)
+    Class snapshotClass = NSClassFromString(@"XCElementSnapshot");
+    SEL mapSelector = NSSelectorFromString(@"axAttributesForElementSnapshotKeyPaths:isMacOS:");
+    if (![snapshotClass respondsToSelector:mapSelector]) {
+        return nil;
+    }
+    id attributes = ((id (*)(id, SEL, id, BOOL))objc_msgSend)(snapshotClass, mapSelector, keyPaths, NO);
+    if ([attributes isKindOfClass:NSSet.class]) {
+        attributes = [(NSSet *)attributes allObjects];
+    }
+    if (![attributes isKindOfClass:NSArray.class] || [(NSArray *)attributes count] == 0) {
+        return nil;
+    }
+
+    NSError *error = nil;
+    id result = nil;
+    @try {
+        result = [AXClient requestSnapshotForElement:element
+                                          attributes:attributes
+                                          parameters:[AXClient defaultParameters]
+                                               error:&error];
+    } @catch (NSException *exception) {
+        NSLog(@"Reduced snapshot raised %@: %@", exception.name, exception.reason);
+        return nil;
+    }
+    if (nil == result) {
+        NSLog(@"Reduced snapshot failed: %@", error);
+        return nil;
+    }
+    id snapshot = [result valueForKey:@"rootElementSnapshot"];
+    if (![snapshot respondsToSelector:@selector(dictionaryRepresentation)]) {
+        return nil;
+    }
+    return [snapshot dictionaryRepresentation];
+}
+
 @end
