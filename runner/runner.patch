diff --git a/DeviceKitTests/JSONRPC/Handlers/IOFill.swift b/DeviceKitTests/JSONRPC/Handlers/IOFill.swift
new file mode 100644
index 0000000..fd203fa
--- /dev/null
+++ b/DeviceKitTests/JSONRPC/Handlers/IOFill.swift
@@ -0,0 +1,155 @@
+import XCTest
+import os
+
+// device.io.fill: a whole form in one round trip.
+//
+// Every XCUIElement access is a fresh accessibility query (60-150 ms each;
+// the first version spent 5 s on ~40 of them for three fields). So: ONE
+// snapshot resolves every field's frame up front; taps and typing go straight
+// to the event synthesizer by coordinate; and one snapshot at the end proves
+// every value.
+struct IOFillField: Codable {
+    let match: String      // label, placeholder, identifier or value
+    let text: String
+}
+
+struct IOFillRequest: Codable {
+    let fields: [IOFillField]
+    let submit: String?
+}
+
+@MainActor
+struct IOFillMethodHandler: RPCMethodHandler {
+    static let methodName = "device.io.fill"
+    private let logger = Logger(subsystem: Bundle.main.bundleIdentifier!, category: "IOFill")
+    private static let fieldTypes: Set<XCUIElement.ElementType> = [.textField, .secureTextField, .searchField, .textView]
+
+    private struct Node {
+        let type: XCUIElement.ElementType
+        let frame: CGRect
+        let keys: [String]     // identifier, label, placeholder, value
+        let value: String
+        let enabled: Bool
+        var placeholder: String { keys[2] }
+    }
+
+    func execute(params: JSONValue?) async throws -> JSONValue {
+        let request = try decodeParams(IOFillRequest.self, from: params)
+        let start = Date()
+        guard let app = RunningApp.getForegroundApp() else {
+            throw RPCMethodError.internalError("no foreground app")
+        }
+        let nodes = try snapshotNodes(app)
+        let targets = try request.fields.map { f in (try pick(nodes, f.match, types: Self.fieldTypes), f) }
+
+        // Per field: tap, a short settle for the keyboard to take focus, then
+        // the text as its own typing record (a touch path and a text path in
+        // one record types nothing). A tap that missed cannot pass silently:
+        // the final snapshot proves every value.
+        for (node, f) in targets {
+            try await tap(CGPoint(x: node.frame.midX, y: node.frame.midY))
+            try? await Task.sleep(nanoseconds: 80_000_000)
+            var path = PointerEventPath.pathForTextInput()
+            path.type(text: deletes(node.value, node.placeholder) + f.text, typingSpeed: 1000)
+            let rec = EventRecord(orientation: .portrait)
+            _ = rec.add(path)
+            try await RunnerDaemonProxy().synthesize(eventRecord: rec)
+        }
+
+        var bad = try await verify(app, targets, within: 1.5)
+        // A field that holds something else (an input method such as Pinyin
+        // turned letters into a composition) is retried once with XCTest's own
+        // typeText, which commits characters directly, then proven again.
+        if !bad.isEmpty {
+            for (node, f) in targets where bad[f.match] != nil {
+                let el = app.descendants(matching: node.type).matching(
+                    NSPredicate(format: "identifier == %@ OR label == %@ OR placeholderValue == %@", f.match, f.match, f.match)).firstMatch
+                guard el.exists else { continue }
+                el.tap()
+                el.typeText(deletes(bad[f.match] ?? "", node.placeholder) + f.text)
+            }
+            bad = try await verify(app, targets, within: 0)
+        }
+        guard bad.isEmpty else {
+            let msg = targets.compactMap { node, f -> String? in
+                guard let got = bad[f.match] else { return nil }
+                return "\(f.match): holds \(node.type == .secureTextField ? "\(got.count) chars" : "\"\(got)\"")"
+            }
+            throw RPCMethodError.internalError(msg.joined(separator: "; "))
+        }
+
+        if let submit = request.submit {
+            // The keyboard may cover the button: dismiss it, then re-read once.
+            try await RunnerDaemonProxy().send(string: "\n", typingFrequency: 1000)
+            let b = try pick(try snapshotNodes(app), submit, types: [.button])
+            guard b.enabled else {
+                throw RPCMethodError.internalError("\(submit): still disabled after filling")
+            }
+            try await tap(CGPoint(x: b.frame.midX, y: b.frame.midY))
+        }
+        let ms = Int(Date().timeIntervalSince(start) * 1000)
+        logger.info("fill \(request.fields.count) field(s) in \(ms) ms")
+        return .object(["ms": .double(Double(ms))])
+    }
+
+    private func snapshotNodes(_ app: XCUIApplication) throws -> [Node] {
+        var nodes: [Node] = []
+        func walk(_ s: XCUIElementSnapshot) {
+            let v = (s.value as? String) ?? ""
+            nodes.append(Node(type: s.elementType, frame: s.frame,
+                              keys: [s.identifier, s.label, s.placeholderValue ?? "", v],
+                              value: v, enabled: s.isEnabled))
+            s.children.forEach(walk)
+        }
+        walk(try app.snapshot())
+        return nodes
+    }
+
+    // verify returns the fields whose value does not match, keyed by match,
+    // with what they hold. Secure fields compare by length (their value is dots).
+    private func verify(_ app: XCUIApplication, _ targets: [(Node, IOFillField)], within: TimeInterval) async throws -> [String: String] {
+        let deadline = Date().addingTimeInterval(within)
+        var bad: [String: String] = [:]
+        repeat {
+            let now = try snapshotNodes(app).filter { Self.fieldTypes.contains($0.type) }
+            bad = [:]
+            for (node, f) in targets {
+                // Match the field again by type and origin: a field grows as
+                // it fills (Contacts' name rows widen), so an exact frame
+                // comparison found nothing and read the field as empty.
+                let got = now.first { $0.type == node.type && $0.frame.origin == node.frame.origin }?.value
+                    ?? now.first { $0.type == node.type && $0.frame.intersects(node.frame) }?.value ?? ""
+                let ok = node.type == .secureTextField ? got.count == f.text.count : got == f.text
+                if !ok { bad[f.match] = got }
+            }
+            if bad.isEmpty { break }
+            try? await Task.sleep(nanoseconds: 50_000_000)
+        } while Date() < deadline
+        return bad
+    }
+
+    // deletes clears an existing value (a placeholder is not a value).
+    private func deletes(_ value: String, _ placeholder: String) -> String {
+        value.isEmpty || value == placeholder ? "" : String(repeating: XCUIKeyboardKey.delete.rawValue, count: value.count)
+    }
+
+    private func pick(_ nodes: [Node], _ match: String, types: Set<XCUIElement.ElementType>) throws -> Node {
+        let m = match.lowercased()
+        let cands = nodes.filter { types.contains($0.type) }
+        for exact in [true, false] {
+            let hit = cands.filter { n in n.keys.contains { k in
+                let k = k.lowercased()
+                return !k.isEmpty && (exact ? k == m : k.contains(m))
+            } }
+            if hit.count == 1 { return hit[0] }
+            if hit.count > 1 { throw RPCMethodError.invalidParams("\(match): matches \(hit.count) elements") }
+        }
+        throw RPCMethodError.invalidParams("\(match): no such field")
+    }
+
+    private func tap(_ p: CGPoint) async throws {
+        let rec = EventRecord(orientation: .portrait)
+        _ = rec.addPointerTouchEvent(at: p, touchUpAfter: 0.03)
+        try await RunnerDaemonProxy().synthesize(eventRecord: rec)
+    }
+}
diff --git a/DeviceKitTests/JSONRPC/Handlers/IOFind.swift b/DeviceKitTests/JSONRPC/Handlers/IOFind.swift
new file mode 100644
index 0000000..b6cad94
--- /dev/null
+++ b/DeviceKitTests/JSONRPC/Handlers/IOFind.swift
@@ -0,0 +1,68 @@
+import XCTest
+import os
+
+// device.find: answer "is this on screen, and where" with one predicate query
+// instead of a full tree dump (0.6-0.9 s). Returns the matches' type, label
+// and frame, capped. Generic: any element type, exact or contains match, and
+// an optional wait so "until it appears" polls on device, not over the wire.
+struct IOFindRequest: Codable {
+    let text: String
+    let type: String?      // "navigationBar", "button", "any" (default)
+    let contains: Bool?
+    let wait: Double?      // seconds to wait for at least one match
+    let limit: Int?
+}
+
+@MainActor
+struct IOFindMethodHandler: RPCMethodHandler {
+    static let methodName = "device.find"
+
+    private static let types: [String: XCUIElement.ElementType] = [
+        "any": .any, "navigationbar": .navigationBar, "button": .button, "cell": .cell,
+        "statictext": .staticText, "textfield": .textField, "securetextfield": .secureTextField,
+        "switch": .switch, "tab": .tab, "tabbar": .tabBar, "link": .link, "alert": .alert,
+        "searchfield": .searchField, "textview": .textView, "image": .image,
+    ]
+
+    func execute(params: JSONValue?) async throws -> JSONValue {
+        let r = try decodeParams(IOFindRequest.self, from: params)
+        let start = Date()
+        let t = Self.types[(r.type ?? "any").lowercased()] ?? .any
+        let p = (r.contains ?? false)
+            ? NSPredicate(format: "label CONTAINS[c] %@ OR identifier CONTAINS[c] %@ OR value CONTAINS[c] %@", r.text, r.text, r.text)
+            : NSPredicate(format: "label == %@ OR identifier == %@ OR value == %@", r.text, r.text, r.text)
+        let deadline = Date().addingTimeInterval(min(max(r.wait ?? 0, 0), 10))
+        var out: [JSONValue] = []
+        repeat {
+            out = []
+            // Re-resolve the foreground app every poll: right after a launch
+            // or deep link the previous app (or SpringBoard) is still in front.
+            guard let app = RunningApp.getForegroundApp() else {
+                try? await Task.sleep(nanoseconds: 50_000_000)
+                continue
+            }
+            let q = app.descendants(matching: t).matching(p)
+            // q.count, not firstMatch: firstMatch on no match waits out
+            // XCTest's ~2 s existence timeout (measured 2.2 s vs 0.13 s), and
+            // "not there yet" is this method's common answer.
+            let els = (0..<min(q.count, r.limit ?? 5)).map { q.element(boundBy: $0) }
+            for el in els {
+                guard let s = try? el.snapshot() else { continue }
+                out.append(.object([
+                    "type": .double(Double(s.elementType.rawValue)),
+                    "label": .string(s.label),
+                    "identifier": .string(s.identifier),
+                    "x": .double(Double(s.frame.minX)), "y": .double(Double(s.frame.minY)),
+                    "width": .double(Double(s.frame.width)), "height": .double(Double(s.frame.height)),
+                    "enabled": .bool(s.isEnabled),
+                ]))
+            }
+            if !out.isEmpty { break }
+            try? await Task.sleep(nanoseconds: 50_000_000)
+        } while Date() < deadline
+        return .object([
+            "matches": .array(out),
+            "ms": .double(Double(Int(Date().timeIntervalSince(start) * 1000))),
+        ])
+    }
+}
